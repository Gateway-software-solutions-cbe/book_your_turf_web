{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    
    /* Disable unused variable checks */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    "strict": true,
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}